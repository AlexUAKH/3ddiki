generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

// npx prisma migrate dev --name add_model_name to apply changes and create migration

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String    @default("") @map("name")
  lastName         String    @default("") @map("last_name")
  password         String    @map("password")
  role             Role      @default(USER)
  sessions         Session[]
  isEmailVerified  Boolean   @default(false)
  stripeCustomerId String?   @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ip           String?  @map("ip")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Filament {
  id      Int             @id @default(autoincrement())
  name    String          @unique @map("name")
  typeId  Int
  brandId Int
  colors  FilamentColor[]
  price   Int             @default(0) @map("price") // 1 kg
  stock   Int             @default(0) @map("stock") // in grams

  type  FilamentType  @relation(fields: [typeId], references: [id])
  brand FilamentBrand @relation(fields: [brandId], references: [id])

  @@map("filament")
}

model FilamentType {
  id        Int        @id @default(autoincrement())
  name      String     @unique @map("name")
  filaments Filament[]

  @@map("filamentTypes")
}

model FilamentBrand {
  id        Int        @id @default(autoincrement())
  name      String     @unique @map("name")
  filaments Filament[]

  @@map("filamentBrands")
}

model FilamentColor {
  id       Int        @id @default(autoincrement())
  color    String     @unique @map("color")
  name     String     @default("") @map("name")
  filament Filament[]

  @@map("filamentColors")
}
