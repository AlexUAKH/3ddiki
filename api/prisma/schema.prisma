generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MANAGER
}

// npx prisma migrate dev --name add_model_name to apply changes and create migration
// export
// "$(brew --prefix postgresql@17)/bin/pg_dump" \
//  -Fc \
//  -v \
//  -d __DATABASE_URL__ \
//  -n public \
//  -f db_dump.bak

// import
// "$(brew --prefix postgresql@17)/bin/pg_restore" \
//   -d 'postgres://c842075e41821b1c7674f82a328f0a9f69a65698b649cc2eb6d84319af4099f3:sk_vxL2naWJ662fRYZK27B01@db.prisma.io:5432/postgres?sslmode=require' \
//   -v \
//   ./db_dump.bak \
//   && echo "-complete-"
model User {
  id               String     @id @default(uuid())
  email            String     @unique
  name             String     @default("") @map("name")
  lastName         String     @default("") @map("last_name")
  password         String     @map("password")
  role             Role       @default(USER)
  sessions         Session[]
  reviews          Review[]
  favorites        Favorite[]
  isEmailVerified  Boolean    @default(false)
  stripeCustomerId String?    @map("stripe_customer_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ip           String?  @map("ip")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Filament {
  id              Int              @id @default(autoincrement())
  name            String           @unique @map("name")
  typeId          Int
  brandId         Int
  colors          FilamentColor[]
  price           Int              @default(0) @map("price") // 1 kg
  stock           Int              @default(0) @map("stock") // in grams
  productVariants ProductVariant[]

  type  FilamentType  @relation(fields: [typeId], references: [id])
  brand FilamentBrand @relation(fields: [brandId], references: [id])

  @@map("filament")
}

model FilamentType {
  id        Int        @id @default(autoincrement())
  name      String     @unique @map("name")
  filaments Filament[]

  @@map("filamentTypes")
}

model FilamentBrand {
  id        Int        @id @default(autoincrement())
  name      String     @unique @map("name")
  filaments Filament[]

  @@map("filamentBrands")
}

model FilamentColor {
  id       Int        @id @default(autoincrement())
  color    String     @unique @map("color")
  name     String     @default("") @map("name")
  filament Filament[]

  @@map("filamentColors")
}

enum MediaOwnerType {
  PRODUCT
  USER
  FILAMENT
  PRODUCT_VARIANT
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model File {
  id           Int            @id @default(autoincrement())
  filename     String
  originalName String
  path         String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  type         MediaType
  ownerType    MediaOwnerType
  ownerId      Int

  createdAt DateTime @default(now())

  //product   Filament? @relation(fields: [ownerId], references: [id])
  // user      User?     @relation(fields: [ownerId], references: [id])
  productVariant ProductVariant? @relation(fields: [ownerId], references: [id])

  @@index([ownerType, ownerId])
}

model ProductCategory {
  id       Int       @id @default(autoincrement())
  title    String    @unique @map("title")
  products Product[]

  @@map("productCategories")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  productId Int?     @map("product_id")
  rate      Int      @map("rate")
  text      String   @default("") @map("text")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

model ProductVariant {
  id         Int @id @default(autoincrement())
  productId  Int @map("product_id")
  filamentId Int @map("filament_id")
  price      Int @default(0) @map("price")
  stock      Int @default(0) @map("stock") // in grams

  images   File[] // @relation("ProductVariantFiles", fields: [id], references: [ownerId])
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filament Filament @relation(fields: [filamentId], references: [id], onDelete: Cascade)

  @@unique([productId, filamentId])
  @@index([productId])
  @@map("productVariants")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String @map("name")
  categoryId  Int    @map("category_id")
  description String @default("") @map("description")
  weight      Int    @default(0) @map("weight") // in grams
  sizeX       Int    @default(0) @map("size_x") // in cm
  sizeY       Int    @default(0) @map("size_y") // in cm
  sizeZ       Int    @default(0) @map("size_z") // in cm
  rate        Float  @default(0) @map("rate")
  discount    Int    @default(0) @map("discount") // in percents

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  favorites Favorite[]
  reviews   Review[]
  variants  ProductVariant[]
  category  ProductCategory  @relation(fields: [categoryId], references: [id])

  @@map("products")
}
